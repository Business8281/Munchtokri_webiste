# ==============================================================================
# FRONTEND / CLIENT-SIDE ENVIRONMENT VARIABLES (Next.js)
# ==============================================================================
# Copy this file to .env.local for local development.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Razorpay Gateway (Client-side)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Web app credentials from Firebase Console)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=munch-tokri.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=munch-tokri
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=munch-tokri.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://munch-tokri-default-rtdb.asia-southeast1.firebasedatabase.app
