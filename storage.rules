rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Product images: public read, authenticated admin write ──────────
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // 10 MB limit
        && request.resource.contentType.matches('image/.*');
    }

    // ── Combo images: public read, authenticated admin write ─────────────
    match /combos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── User-scoped uploads: only owner can write ────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Public assets ────────────────────────────────────────────────────
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
